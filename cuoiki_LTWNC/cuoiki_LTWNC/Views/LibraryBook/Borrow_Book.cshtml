@{
    ViewBag.Title = "View";
}
@{
    ViewBag.Title = "Borrow_Book";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}
@model cuoiki_LTWNC.Models.BookViewModel

<div class="book-details">
    <div class="col-md-12">
        <h1 class="about_taital">Chi tiết phiếu mượn</h1>
        <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
    </div>
    <div class="book-image">
        <img src="@Model.Image" alt="@Model.Title" style="max-width:100px; max-height:150px;" />
    </div>
    <div class="book-info">
        <h3>@Model.Title</h3>
        <p><strong>Tên tác giả:</strong></p>
        <ol>
            @foreach (var author in Model.AuthorName)
            {
                <li>@author</li>
            }
        </ol>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="col-6">
                    Mã sinh viên: ...
                </div>
                <div class="col-6">
                    Tên sinh viên: ...
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-6 justify-content-center align-items-center">
                <a href="@Url.Action("Details", "LibraryBook", new { id = @Model.BookID })" class="btn btn-primary">Quay lại</a>
            </div>
            <div class="col-6 justify-content-center align-items-center">
                <!-- Bug here, not @Model.BookID, must be StudentID -->
                <a href="@Url.Action("DanhSachPhieuMuon", "LibraryBook", new { id = @Model.BookID })" class="btn btn-success">Đăng kí mượn</a>
            </div>
        </div>
    </div>
</div>


