@{
    ViewBag.Title = "Borrow_Book";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var studentID = Session["StudentID"];
    var studentName = Session["StudentName"];
    var email = Session["Email"];

    // Calculate today's date and one month from today
    var borrowDate = DateTime.Today.AddDays(2);
    var returnDate = borrowDate.AddMonths(2);
}
@model cuoiki_LTWNC.Models.BookViewModel

<div class="book-details">
    <div class="col-md-12">
        <h1 class="about_taital">Chi tiết phiếu mượn</h1>
        <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
    </div>
    <div class="book-image">
        <img src="@Model.Image" alt="@Model.Title" style="max-width:100px; max-height:150px;" />
    </div>
    <div class="book-info">
        <h3>@Model.Title</h3>
        <p><strong>Tên tác giả:</strong></p>
        <p><strong>Mô tả:</strong> @Model.Description</p>
        <ol>
            @foreach (var author in Model.AuthorName)
            {
                <li>@author</li>
            }
        </ol>
    </div>
</div>
<div class="book-details">
    <div class="col-md-12">
        <div class="container">
            <div class="row">
                <h3>Thông tin người mượn</h3>
                <div class="col-12">
                    <p><strong>Mã sinh viên:</strong> @studentID</p>
                </div>
                <div class="col-12">
                    <p><strong>Tên sinh viên:</strong> @studentName </p>
                </div>
                <div class="col-12">
                    <p><strong>Email:</strong> @email </p>
                </div>
                <div>
                    <h5>Ngày mượn sách:</h5>
                    <p>@borrowDate</p>
                    <h5>Ngày trả sách:</h5>
                    <p>@returnDate</p>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="col-6 text-center">
            <a href="@Url.Action("Details", "LibraryBook", new { id = @Model.BookID })" class="btn btn-primary">Quay lại</a>
        </div>
        <div class="col-6 text-center">
            <a href="@Url.Action("DanhSachPhieuMuon", "LibraryBook", new { studentID = studentID })" onclick="borrowBook()" class="btn btn-success">Đăng kí mượn</a>
        </div>
    </div>
</div>

<script>
    async function borrowBook() {
        const studentID = '@studentID';
        const bookID = '@Model.BookID';
        const borrowDate = '@borrowDate.ToString("yyyy-MM-dd")';
        const returnDate = '@returnDate.ToString("yyyy-MM-dd")';

        fetch('@Url.Action("BorrowBook", "LibraryBook")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ studentID, bookID, borrowDate, returnDate })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Borrowing record created successfully!');
                window.location.href = '@Url.Action("DanhSachPhieuMuon", "LibraryBook", new { studentID = studentID })';
            } else {
                alert('Failed to create borrowing record.');
            }
        })
        .catch(error => console.error('Error:', error));
    }
</script>

