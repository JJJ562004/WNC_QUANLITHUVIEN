@model cuoiki_LTWNC.Models.Staff

@{
    ViewBag.Title = "Quản lí nhhân viên";
}

@section Banner{}

<!-- Form quản lý sách-->
<div class="container mt-4">
    <form asp-action="ManageStaff" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="row mb-3">
            <label for="LastName" class="col-sm-2 col-form-label">Họ</label>
            <div class="col-sm-10">
                <input asp-for="LastName" id="LastName" class="form-control" placeholder="Họ" required />
            </div>
        </div>

        <div class="row mb-3">
            <label for="FirstName" class="col-sm-2 col-form-label">Tên</label>
            <div class="col-sm-10">
                <input asp-for="FirstName" id="FirstName" class="form-control" placeholder="Tên" required />
            </div>
        </div>

        <div class="row mb-3">
            <label for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" id="Email" class="form-control" placeholder="Nhập email" required />
            </div>
        </div>

        <div class="row mb-3">
            <label for="PhoneNumber" class="col-sm-2 col-form-label">Số điện thoại</label>
            <div class="col-sm-10">
                <input asp-for="PhoneNumber" id="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" required />
            </div>
        </div>

        <div class="row mb-3">
            <label for="Role" class="col-sm-2 col-form-label">Vai trò</label>
            <div class="col-sm-10">
                <input asp-for="Role" id="Role" class="form-control" placeholder="Nhập vai trò" />
            </div>
        </div>


        <div class="text-end">
            <button type="submit" name="action" value="Create" class="btn btn-primary me-2">Thêm</button>
            <button type="submit" name="action" value="Update" class="btn btn-warning me-2">Sửa</button>
            <button type="submit" name="action" value="Delete" class="btn btn-danger">Xóa</button>
        </div>
    </form>

</div>
