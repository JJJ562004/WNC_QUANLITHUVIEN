@{
    ViewBag.Title = "Quản lí sách";
}
@section Banner{}
<div class="book-details">
    <div class="col-md-12">
        <h1 class="about_taital">Chi tiết sách</h1>
        <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
    </div>
    <div class="book-image">
        <img src="@Model.Image" alt="@Model.Title" style="max-width:350px" />
    </div>
    <div class="book-info">
        <h3>@Model.Title</h3>
        <p><strong>Năm ra mắt:</strong> @Model.PublishYear</p>
        <p><strong>Số lượng:</strong> @Model.Quantity</p>
        <p><strong>Mô tả:</strong> @Model.Description</p>
        <p><strong>Tên tác giả:</strong></p>
        <ul>
            @foreach (var author in Model.AuthorName)
            {
                <li>@author</li>
            }
        </ul>
    </div>
    <div>
        <a href="@Url.Action("Index", "LibraryBook")" class="btn btn-primary">Quay lại</a>
    </div>
</div>
