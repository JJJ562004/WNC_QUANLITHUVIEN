@{
    ViewBag.Title = "";
    Layout = "~/Views/Shared/User_Layout.cshtml";
}
@section Banner{
    <!-- banner section start -->
    
    <!-- banner section end -->
}
<!-- coffee section start -->
<div class="coffee_section layout_padding">
    <div class="container">
        <div class="row">
            <h1 class="coffee_taital">Danh mục sách</h1>
            <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
        </div>
    </div>
    <div class="coffee_section_2">
        <div id="main_slider" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="container-fluid">
                        <div class="row">

                            @foreach (var book in Model)
                            {
                                <div class="col-lg-3 col-md-6" style="margin-top:5px; margin-bottom: 5px">
                                    <div class="coffee_img">
                                        <img src="@book.Image" style="max-width:250px; max-height:350px;" />
                                    </div>
                                    <h3 class="types_text">@book.Title</h3>
                                    <p class="looking_text">Số lượng: @book.Quantity</p>
                                    <div class="read_bt">
                                        <a href="@Url.Action("Details", "LibraryBook", new { id = book.BookID })">View Details</a>
                                    </div>
                                </div>}
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <a class="carousel-control-prev" href="#main_slider" role="button" data-slide="prev">
            <i class="fa fa-arrow-left"></i>
        </a>
        <a class="carousel-control-next" href="#main_slider" role="button" data-slide="next">
            <i class="fa fa-arrow-right"></i>
        </a>
    </div>
</div>


<div class="contact_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <h1 class="contact_taital">Get In Touch</h1>
                <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="contact_section_2">
            <div class="row">
                <div class="col-md-12">
                    <div class="mail_section_1">
                        <input type="text" class="mail_text" placeholder="Your Name" name="Your Name">
                        <input type="text" class="mail_text" placeholder="Your Email" name="Your Email">
                        <input type="text" class="mail_text" placeholder="Your Phone" name="Your Phone">
                        <textarea class="massage-bt" placeholder="Massage" rows="5" id="comment" name="Massage"></textarea>
                        <div class="send_bt"><a href="#">SEND</a></div>
                    </div>
                </div>
                <div class="map_main">
                    <div class="map-responsive">
                        <iframe src="https://www.google.com/maps/embed/v1/place?key=AIzaSyA0s1a7phLN0iaD6-UE7m4qP-z21pH0eSc&amp;q=Eiffel+Tower+Paris+France" width="250" height="500" frameborder="0" style="border:0; width: 100%;" allowfullscreen=""></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- contact section end -->