                </div>
            </div>
            <div class="client_taital_main">
                <div class="client_left">
                    <div class="client_img"><img src="https://scontent.fdad8-2.fna.fbcdn.net/v/t39.30808-6/434660998_950705533123582_8167939968196413712_n.jpg?_nc_cat=109&ccb=1-7&_nc_sid=6ee11a&_nc_ohc=HFAHDTKJR-8Q7kNvgEUYvrF&_nc_zt=23&_nc_ht=scontent.fdad8-2.fna&_nc_gid=AWiptuytB4ePP_O4epNWYsU&oh=00_AYBZEuCwob4WjQCfAOHZyjkPsLf4ruU_IpBDNx4StTCZyQ&oe=675E05B7"></div>
                </div>
                <div class="client_right">
                    <h3 class="moark_text">Trần Văn Bình</h3>
