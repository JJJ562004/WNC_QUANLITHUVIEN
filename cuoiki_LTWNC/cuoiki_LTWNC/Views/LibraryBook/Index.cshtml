<!-- client section end -->
<!-- blog section start -->
<div class="blog_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="about_taital">Bài viết liên quan</h1>
                <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
            </div>
        </div>
        <div class="blog_section_2">
            <div class="row">
                <div class="col-md-6">
                    <div class="blog_box">
                        <div class="blog_img" ><img src="https://cdn.pixabay.com/photo/2014/10/14/20/14/library-488690_640.jpg"></div>
                        <h4 class="date_text">10 December</h4>
                        <h4 class="prep_text">Library Management Tips</h4>
                        <p class="lorem_text">Khám phá cách tổ chức và quản lý thư viện hiệu quả để giúp người dùng dễ dàng tìm kiếm và tiếp cận tài liệu.</p>
                    </div>
                    <div class="read_bt"><a href="#">Read More</a></div>
                </div>
                <div class="col-md-6">
                    <div class="blog_box">
                        <div class="blog_img"><img src="https://img.lovepik.com/photo/20211122/medium/lovepik-national-library-picture_500661719.jpg"></div>
                        <h4 class="date_text">10 December</h4>
                        <h4 class="prep_text">Modern Digital Libraries</h4>
                        <p class="lorem_text">Thư viện số đang thay đổi cách chúng ta đọc sách, nghiên cứu và học tập với tài nguyên phong phú và dễ tiếp cận.</p>
                    </div>
                    <div class="read_bt"><a href="#">Read More</a></div>
                </div>
            </div>

        </div>
    </div>
</div>
<!-- blog section end -->
<!-- contact section start -->
<div class="contact_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-sm-12">
                <h1 class="contact_taital">Phản hồi ý kiến</h1>
                <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
            </div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="contact_section_2">
            <div class="row">
                <div class="col-md-12">
                    <div class="mail_section_1">
                        <input type="text" class="mail_text" placeholder="Your Name" name="Your Name">
                        <input type="text" class="mail_text" placeholder="Your Email" name="Your Email">
                        <input type="text" class="mail_text" placeholder="Your Phone" name="Your Phone">
                        <textarea class="massage-bt" placeholder="Massage" rows="5" id="comment" name="Massage"></textarea>
                        <div class="send_bt"><a href="#">SEND</a></div>
                    </div>
                </div>
                <div class="map_main">
                    <div class="map-responsive">
                        <iframe src="https://www.google.com/maps/embed/v1/place?key=AIzaSyA0s1a7phLN0iaD6-UE7m4qP-z21pH0eSc&amp;q=Eiffel+Tower+Paris+France" width="250" height="500" frameborder="0" style="border:0; width: 100%;" allowfullscreen=""></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- contact section end -->