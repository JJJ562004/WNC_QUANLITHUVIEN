<!-- coffee section start -->
<!-- coffee section end -->
<div class="coffee_section layout_padding">
    <div class="container">
        <div class="row">
            <h1 class="coffee_taital">Danh mục sách</h1>
            <div class="bulit_icon"><img src="~/images/bulit-icon.png"></div>
        </div>

        <!-- Categories -->
        <div class="category_section">
            <!-- Tiêu đề Danh mục với liên kết -->
            <a href="@Url.Action("Index", "LibraryBook")" class="category_title">Danh mục</a>

            <!-- Danh sách danh mục -->
            <div class="category_list">
                @foreach (var category in Model.Categories)
                {
                    <a href="@Url.Action("Index", "LibraryBook", new { categoryId = category.CategoryID })" class="category_link">
                        @category.CategoryName
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Books -->
    <div class="coffee_section_2">
        <div id="main_slider" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="container-fluid">
                        <div class="row">
                            @foreach (var book in Model.Books)
                            {
                                <div class="col-lg-3 col-md-6" style="margin-top:5px; margin-bottom: 5px">
                                    <div class="coffee_img">
                                        <img src="@book.Image" style="max-width:250px; max-height:350px;" />
                                    </div>
                                    <h3 class="types_text">@book.Title</h3>
                                    <p class="looking_text">Số lượng: @book.Quantity</p>
                                    <div class="read_bt">
                                        <a href="@Url.Action("Details", "LibraryBook", new { id = book.BookID })">View Details</a>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <a class="carousel-control-prev" href="#main_slider" role="button" data-slide="prev">
                <i class="fa fa-arrow-left"></i>
            </a>
            <a class="carousel-control-next" href="#main_slider" role="button" data-slide="next">
                <i class="fa fa-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- about section start -->
<div class="about_section layout_padding">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h1 class="about_taital">Thư viện chúng tôi</h1>
                <div class="bulit_icon"><img src="https://watermark.lovepik.com/photo/20211119/large/lovepik-a-neatly-arranged-bookshelf-in-the-library-picture_500210603.jpg"></div>
            </div>
        </div>

    </div>
</div>
<!-- about section end -->
<!-- client section start -->
