@{
    ViewBag.Title = "Dữ liệu thống kê";
}
@section Banner {}

<script src="https://code.highcharts.com/highcharts.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetchChartDataCategory();
        fetchChartDataStaff();

        // Fetch chart data for book categories
        function fetchChartDataCategory() {
            $.ajax({
                url: '@Url.Action("GetChartDataCategory", "LibraryBook")', // Adjust route as needed
                method: 'GET',
                success: function (data) {
                    const categories = data.map(item => item.CategoryName);
                    const bookCounts = data.map(item => item.BookCount);

                    // Initialize the category chart
                    Highcharts.chart('categoryChartContainer', {
                        chart: {
                            type: 'bar'
                        },
                        title: {
                            text: 'Sách và thể loại'
                        },
                        xAxis: {
                            categories: categories
                        },
                        yAxis: {
                            title: {
                                text: 'Số lượng sách'
                            },
                            allowDecimals: false
                        },
                        series: [{
                            name: 'Sách',
                            data: bookCounts
                        }]
                    });
                },
                error: function (err) {
                    console.error('Error fetching chart data for categories:', err);
                }
            });
        }

        // Fetch chart data for staff roles
        function fetchChartDataStaff() {
            $.ajax({
                url: '@Url.Action("GetChartDataStaff", "LibraryBook")', // Adjust route as needed
                method: 'GET',
                success: function (data) {
                    const roles = data.map(item => item.Role);
                    const staffCounts = data.map(item => item.StaffCount);

                    // Initialize the staff role chart
                    Highcharts.chart('staffChartContainer', {
                        chart: {
                            type: 'bar'
                        },
                        title: {
                            text: 'Nhân viên và vai trò'
                        },
                        xAxis: {
                            categories: roles
                        },
                        yAxis: {
                            title: {
                                text: 'Số lượng nhân viên'
                            },
                            allowDecimals: false
                        },
                        series: [{
                            name: 'Nhân viên',
                            data: staffCounts
                        }]
                    });
                },
                error: function (err) {
                    console.error('Error fetching chart data for staff:', err);
                }
            });
        }
    });
</script>

<div>
    <div id="categoryChartContainer" style="width: 100%; height: 400px;"></div>
</div>

<div>
    <div id="staffChartContainer" style="width: 100%; height: 400px;"></div>
</div>
