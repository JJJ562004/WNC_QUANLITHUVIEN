@{
    ViewBag.Title = "Dữ liệu thống kê";
}
@section Banner {}
<script src="https://code.highcharts.com/highcharts.js"></script>
<div id="container" style="width:100%; height:400px;"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        fetchChartData();

        function fetchChartData() {
            $.ajax({
                url: '@Url.Action("GetChartData", "LibraryBook")', // Adjust route as needed
                method: 'GET',
                success: function (data) {
                    const categories = data.map(item => item.CategoryName);
                    const bookCounts = data.map(item => item.BookCount);

                    // Initialize the chart
                    Highcharts.chart('container', {
                        chart: {
                            type: 'bar'
                        },
                        title: {
                            text: 'Sách và thể loại'
                        },
                        xAxis: {
                            categories: categories
                        },
                        yAxis: {
                            title: {
                                text: 'Số lượng sách'
                            },
                            allowDecimals: false
                        },
                        series: [{
                            name: 'Sách',
                            data: bookCounts
                        }]
                    });
                },
                error: function (err) {
                    console.error('Error fetching chart data:', err);
                }
            });
        }
    });
</script>