
@{
    ViewBag.Title = "Forgot Password";
    Layout = "~/Views/Page_Login_VanBinh.cshtml";
}

<section class="container" style="display: flex; justify-content: center; align-items: center; height: 100vh; background-color: #f3f4f6;">
    <div class="login-container" style="position: relative; width: 400px; padding: 2rem; background: rgba(255, 255, 255, 0.15);
                                        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37); border-radius: 10px; backdrop-filter: blur(5px); text-align: center;">
        <div class="circle circle-one" style="position: absolute; background-color: rgba(255, 255, 255, 0.2); border-radius: 50%;
                                              filter: blur(5px); width: 150px; height: 150px; top: -50px; left: -50px;"></div>
        <div class="form-container" style="position: relative; z-index: 10;">
            <img src="https://raw.githubusercontent.com/hicodersofficial/glassmorphism-login-form/master/assets/illustration.png"
                 alt="illustration"
                 style="width: 100px; margin-bottom: 20px;">
            <h1 class="opacity" style="opacity: 0.8; color: #333;">FORGOT PASSWORD</h1>
            <form action="/Account/Login" method="Post">
                <input type="text" name="Email" placeholder="Nhập Email của bạn"
                       style="width: 100%; padding: 10px; margin: 10px 0; border: none; border-radius: 5px; background-color: #f5f5f5; font-size: 1rem;">
                <button type="submit" class="opacity"
                        style="width: 100%; padding: 10px; border: none; border-radius: 5px; background-color: #4caf50; color: #fff; font-size: 1rem; cursor: pointer;">
                    SEND LINK
                </button>
            </form>
            <div class="register-forget opacity" style="margin-top: 15px; opacity: 0.8; color: #333;">
                <a href="/Account/Login" style="color: #007bff; text-decoration: none;">BACK TO LOGIN</a>
            </div>
        </div>
        <div class="circle circle-two" style="position: absolute; background-color: rgba(255, 255, 255, 0.2); border-radius: 50%;
                                              filter: blur(5px); width: 100px; height: 100px; bottom: -30px; right: -30px;"></div>
    </div>
</section>
