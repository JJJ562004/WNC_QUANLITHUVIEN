@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Page_Login_VanBinh.cshtml";
}

<section class="container">
    <div class="login-container">
        <div class="circle circle-one"></div>
        <div class="form-container">
            <img src="https://raw.githubusercontent.com/hicodersofficial/glassmorphism-login-form/master/assets/illustration.png" alt="illustration" class="illustration">
            <h1 class="opacity">LOGIN</h1>
            <form action="Verify" method="Post">
                <input type="text" name="MSV" placeholder="Mã sinh viên">
                <input type="password" name="Password" placeholder="Mật Khẩu">
                <button class="opacity" onclick="submitLogin()">SUBMIT</button>
            </form>
            <div class="register-forget opacity">
                <a href="/Account/DangKy">REGISTER</a>
                <a href="/Account/ForgotPassword">FORGOT PASSWORD</a>
            </div>
        </div>
        <script>
            async function submitLogin() {
                const username = document.getElementById("username").value.trim();
                const password = document.getElementById("password").value.trim();

                if (!username || !password) {
                    alert("Vui lòng điền đầy đủ thông tin!");
                    return;
                }

                try {
                    const response = await fetch('~/Views/LibraryBook/index.html', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ MSV: username, Password: password })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Điều hướng đến trang khác nếu thành công
                        window.location.href = "~/Views/LibraryBook/Index"; // Đường dẫn chính xác
                    } else {
                        alert("Tên đăng nhập hoặc mật khẩu không chính xác!");
                    }
                } catch (error) {
                    console.error("Đã xảy ra lỗi:", error);
                    alert("Không thể kết nối đến server. Vui lòng thử lại sau!");
                }
            }
        </script>
        <div class="circle circle-two"></div>
        <div class="theme-btn-container"></div>
        </div>


</section>
