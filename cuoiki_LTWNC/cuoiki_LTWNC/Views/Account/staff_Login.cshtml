@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Page_Login_VanBinh.cshtml";
}

<section class="container">
    <div class="login-container">
        <div class="circle circle-one"></div>
        <div class="form-container">
            <img src="https://raw.githubusercontent.com/hicodersofficial/glassmorphism-login-form/master/assets/illustration.png" alt="illustration" class="illustration">
            <h1 class="opacity">LOGIN</h1>
            <form action="VerifyStaff" method="Post">
                <input type="text" name="StaffID" placeholder="Mã cán bộ">
                <input type="password" name="PhoneNumber" placeholder="Mật Khẩu">
                <button class="opacity">Đăng nhập</button>
            </form>
            <div class="register-forget opacity">
                <a href="/Account/ForgotPassword">Quên mật khẩu</a>
                <a href="/Account/SwitchStudent">Đăng nhập bằng Sinh Viên</a>
            </div>
        </div>        
        <div class="circle circle-two"></div>
        <div class="theme-btn-container"></div>
    </div>


</section>
